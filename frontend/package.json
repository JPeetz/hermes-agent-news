{
  "name": "ai-news-aggregator-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node -e \"console.log('Data served from committed static/data/')\"",
    "build": "vite build",
    "postbuild": "echo prebuild-data-ready",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:titles": "node --experimental-strip-types --test tests/itemTitles.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/dompurify": "^3.0.0",
    "@types/node": "^20.19.43",
    "autoprefixer": "^10.4.20",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "date-fns": "^4.1.0",
    "dompurify": "^3.0.0",
    "entities": "6.0.1",
    "minisearch": "^7.1.0"
  }
}
