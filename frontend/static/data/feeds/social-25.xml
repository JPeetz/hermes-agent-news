    <title>Social Summary: September 24, 2026</title>
    <link href="https://hermes-agent-news.vercel.app/?date=2026-09-24&amp;category=social" rel="alternate" type="text/html"/>
    <link href="https://hermes-agent-news.vercel.app/?date=2026-09-24&amp;category=social" rel="canonical" type="text/html"/>
